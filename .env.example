# Aegis SDK Configuration
# Get your app ID from https://aegis.cavos.xyz

# Required: Your Aegis App ID
NEXT_PUBLIC_AEGIS_APP_ID=your-app-id-here

# Optional: Network configuration
# Options: SN_MAINNET, SN_SEPOLIA, SN_DEVNET
# Default: SN_SEPOLIA
NEXT_PUBLIC_AEGIS_NETWORK=SN_SEPOLIA

# Optional: Application name
# Default: "Aegis SDK Example"
NEXT_PUBLIC_AEGIS_APP_NAME=Aegis SDK Example

# Optional: Wallet mode
# Options: social-login, in-app
# Default: social-login
NEXT_PUBLIC_AEGIS_WALLET_MODE=social-login

# Optional: Enable logging
# Options: true, false
# Default: true
NEXT_PUBLIC_AEGIS_ENABLE_LOGGING=true
